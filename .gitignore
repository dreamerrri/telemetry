# Release signing - never commit the key or its passwords
/keystore.properties
*.jks
*.keystore

# Gradle / Android Studio
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/captures/

# Build outputs (regenerated by `gradle assembleDebug`)
/build/
/app/build/
/app/release/

# Compiled packages (attach APKs to GitHub Releases instead)
*.apk
*.aab
*.ap_
*.dex

# Kotlin incremental cache
.kotlin/

# Token server (Cloudflare Worker) secrets - never commit
token-server/.dev.vars
token-server/.env*
token-server/node_modules/
